{
  "name": "ambitious-compliance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-standalone.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "depcruise": "depcruise src --output-type err-long",
    "test": "npm run build && node --test \"test/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "contract": "ambitious-contract verify/checks/contract-module.mjs && node --test --test-name-pattern='analysis|invalid read|selfcheck and discovery' test/cli.test.ts",
    "tlc": "bash spec/check.sh",
    "verify": "node verify/run",
    "release:check": "node scripts/release-check.mjs",
    "release:build": "node scripts/release-build.mjs"
  },
  "devDependencies": {
    "@ambitious/kit": "file:vendor/ambitious-kit-0.1.1.tgz",
    "@ambitious/lint": "file:vendor/ambitious-lint-0.1.1.tgz",
    "@ambitious/depcruise": "file:vendor/ambitious-depcruise-0.1.1.tgz",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
